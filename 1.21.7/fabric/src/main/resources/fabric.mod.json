{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": [ "${mod_author}" ],
    "contact": {
        "homepage": "https://github.com/Stein-N/Resource-Backpacks",
        "issues": "https://github.com/Stein-N/Resource-Backpacks/issues"
    },
    "license": "${mod_license}",
    "icon": "icon.png",
    "environment": "*",
    "accessWidener" : "${mod_id}.accesswidener",
    "entrypoints": {
        "main": [ "net.xstopho.resource_backpacks.ResourceBackpacks" ],
        "client": [ "net.xstopho.resource_backpacks.ResourceBackpacksClient" ]
    },
    "mixins": [ "${mod_id}.mixins.json" ],
    "depends": {
        "fabric-api": "*",
        "fabricloader": "*",
        "minecraft": ">=1.21.6 <1.21.8",
        "java": ">=${java_version}",

        "resourceconfigapi": ">=${minecraft_version}-${resource_config_api}",
        "resourcelibrary": ">=${minecraft_version}-${resource_library}"
    },
    "custom": {
        "modmenu": {
            "update-checker": true
        }
    }
}